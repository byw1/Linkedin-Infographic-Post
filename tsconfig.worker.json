{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "dist",
    "noEmit": false,
    "jsx": "preserve",
    "isolatedModules": false
  },
  "include": ["workers/**/*.ts", "lib/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "dist", "app", "components", ".next"]
}
