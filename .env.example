# ============================================================
# REQUIRED — set these on Railway, the rest is configured in /admin
# ============================================================

# Auto-set if you reference the Railway Postgres + Redis services:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/logoswap
REDIS_URL=redis://host:6379

# openssl rand -base64 32
AUTH_SECRET=change-me

# Google OAuth — create at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your email. First sign-in with this address bypasses the allowlist
# and is auto-promoted to admin so you can access /admin.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ============================================================
# OPTIONAL — everything below can be left empty.
# Configure storage and the email allowlist in /admin after first login.
# ============================================================

# Local development override only. In production Auth.js trusts the
# Railway proxy headers automatically (trustHost: true).
# NEXTAUTH_URL=http://localhost:3000

# S3-compatible storage (Cloudflare R2 or MinIO). Optional fallback —
# preferred path is to set these in /admin → Storage.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false

# Email magic links (optional alternative to Google SSO).
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=

# Worker service only — already set in Dockerfile.worker, override if needed.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
