# ============================================================
# REQUIRED — only 3 secrets, the rest is configured in /admin
# ============================================================

# Auto-set if you reference the Railway Postgres + Redis services:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/logoswap
REDIS_URL=redis://host:6379

# openssl rand -base64 32
AUTH_SECRET=change-me

# ============================================================
# OPTIONAL — leave everything below empty unless you need it.
# Sign-in providers, storage, and invites are all managed in /admin
# after the first-run setup wizard creates your admin account.
# ============================================================

# Local development override only. In production Auth.js trusts the
# Railway proxy headers automatically (trustHost: true).
# NEXTAUTH_URL=http://localhost:3000

# Google OAuth — optional. You can configure this in /admin instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# S3-compatible storage. Required for PNG export and logo uploads.
# Either the AWS SDK standard names (preferred) or the S3_* fallbacks.
#
# Railway Bucket service:
#   AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
#   AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
#   AWS_ENDPOINT_URL=${{Bucket.ENDPOINT}}
#   AWS_S3_BUCKET_NAME=${{Bucket.BUCKET}}
#   AWS_DEFAULT_REGION=${{Bucket.REGION}}
#
# Cloudflare R2 (S3_* names also work):
#   AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   AWS_DEFAULT_REGION=auto
#   AWS_S3_BUCKET_NAME=logoswap
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   S3_PUBLIC_URL=https://pub-<id>.r2.dev
#
# S3_PUBLIC_URL is optional — defaults to ${endpoint}/${bucket} which works
# when path-style public reads are enabled on the bucket.
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=true   # default; set to "false" for R2 virtual-hosted

# Worker service only — already set in Dockerfile.worker, override if needed.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
