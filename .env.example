# Database (auto-set by Railway Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/logoswap

# Redis (auto-set by Railway Redis)
REDIS_URL=redis://host:6379

# Auth.js
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links (optional)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Allowlist (comma-separated)
ALLOWED_EMAILS=you@example.com

# S3-compatible storage (Cloudflare R2 or MinIO)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=logoswap
S3_PUBLIC_URL=https://pub-<id>.r2.dev
S3_FORCE_PATH_STYLE=false

# Worker only
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
