# syntax=docker/dockerfile:1.7

# Throwaway image for the one-off bucket copy (see docs/BUCKET-MIGRATION.md).
# Deliberately does not build the Next app — the script only needs the S3
# client, so this builds in seconds instead of minutes.

FROM node:20-bookworm-slim
WORKDIR /app
RUN npm install --no-save @aws-sdk/client-s3@^3.700.0
COPY scripts/migrate-bucket.mjs ./
# NEVER restart on exit: this is a job, not a service. A restart policy here
# would re-run the copy in a loop.
CMD ["node", "migrate-bucket.mjs"]
