generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  image         String?   @map("image_url")
  role          Role      @default(user)
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  // Free-form tags shown on the Members page (industry, focus areas,
  // anything). Lowercase + hyphenated on write so search/group is
  // predictable.
  tags          String[]  @default([])
  // Public profile fields. Bio is short markdown-free text. Socials is
  // a small map of provider → URL, normalized to absolute https:// on
  // write so the Members page can render a working link without
  // re-validating client-side.
  bio           String?
  socials       Json      @default("{}") @db.JsonB

  accounts        Account[]
  sessions        Session[]
  entities        Entity[]
  renders         Render[]
  invitesCreated  Invite[]  @relation("InviteCreatedBy")
  invitesRedeemed Invite[]  @relation("InviteRedeemedBy")
  skillsUploaded  Skill[]   @relation("SkillUploadedBy")
  themesOwned     Theme[]   @relation("ThemeOwner")
  docPagesEdited  DocPage[] @relation("DocPageUpdatedBy")

  @@index([tags], type: Gin, name: "idx_users_tags")
  @@map("users")
}

model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  token       String    @unique
  email       String?
  role        Role      @default(user)
  note        String?
  createdById String    @map("created_by_id") @db.Uuid
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  usedById    String?   @map("used_by_id") @db.Uuid
  usedBy      User?     @relation("InviteRedeemedBy", fields: [usedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdById, createdAt(sort: Desc)], name: "idx_invites_creator")
  @@map("invites")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Entity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  slug            String
  // Additional slugs that should resolve to this same entity. Lets users
  // (and Claude) name the same logo differently without re-uploading —
  // e.g. {slug: "sam-altman", aliases: ["sama", "samaltman"]}.
  aliases         String[]     @default([])
  displayName     String       @map("display_name")
  type            EntityType
  shapePreference ShapePref    @default(square) @map("shape_preference")
  logoUrl         String       @map("logo_url")
  sourceUrl       String?      @map("source_url")
  usageCount      Int          @default(0) @map("usage_count")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, slug], name: "idx_entities_user_slug")
  @@index([userId, lastUsedAt(sort: Desc)], name: "idx_entities_user_last_used")
  @@index([aliases], type: Gin, name: "idx_entities_aliases")
  @@map("entities")
}

model Render {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  filename      String?
  entityCount   Int?         @map("entity_count")
  unknownCount  Int?         @map("unknown_count")
  pngUrl        String?      @map("png_url")
  status        RenderStatus @default(pending)
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)

  // Manual post-tracking fields. Filled in by the user after they
  // actually publish the render somewhere (LinkedIn, X, Instagram).
  // Kept as discrete columns rather than a JSON blob so we can sort
  // and aggregate ("top posts by impressions") without parsing.
  postUrl     String?   @map("post_url")
  impressions Int?
  reactions   Int?
  comments    Int?
  reposts     Int?
  trackedAt   DateTime? @map("tracked_at") @db.Timestamptz(6)

  // Theme used for this render. Null = no theme injection (raw HTML
  // colors only). Set to null on theme deletion so render history
  // survives even if the source theme is gone.
  themeId String? @map("theme_id") @db.Uuid
  theme   Theme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], name: "idx_renders_user")
  @@map("renders")
}

// Brand themes — CSS token blocks (`--bg-canvas`, `--accent`, etc.)
// injected into the editor preview, the puppeteer renderer, and the
// served skill markdown so Claude generates HTML that uses them.
//
// Owner rules:
//  - user_id = null → system theme (the default-dark / default-light
//    seeded on first migration). Always official, never deletable.
//  - user_id = <uuid>, is_official = false → private to the owner
//    (only owner + admins see it).
//  - user_id = <uuid>, is_official = true → admin-promoted, visible
//    to everyone but only the owner / admins can edit.
//
// css = the raw text the user pasted (preserved verbatim so they can
// keep their comments, font-face rules, dark/light variants, etc.).
// tokens = parsed `--key: value` map (light variant) used for skill
// prompt injection — feeding 200 lines of raw CSS into the prompt is
// noisier than feeding the 20 tokens that actually matter.
model Theme {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String
  css         String   @db.Text
  tokens      Json     @default("{}") @db.JsonB
  fontFamily  String?  @map("font_family")
  isOfficial  Boolean  @default(false) @map("is_official")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User?    @relation("ThemeOwner", fields: [userId], references: [id], onDelete: Cascade)
  renders Render[]

  @@index([userId, createdAt(sort: Desc)], name: "idx_themes_user")
  @@index([isOfficial], name: "idx_themes_official")
  @@map("themes")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// Markdown skill files an admin uploads for the team. Anyone signed in
// can list and download them; only admins can upload or delete. The
// actual bytes live in S3 under `skills/<id>.md`; this row stores the
// metadata (name + description from the YAML frontmatter, original
// filename for download, and size for display).
model Skill {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  filename     String
  storageKey   String   @map("storage_key")
  fileSize     Int      @map("file_size")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation("SkillUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], name: "idx_skills_created")
  @@map("skills")
}

// Wiki pages for the team handbook. Replaces the older
// `settings.docs` JSON blob (one giant markdown string) with a
// page-per-topic structure: sidebar lists every page in `position`
// order, each page lives at `/docs/<slug>`.
//
// Slugs are unique workspace-wide and stable — they appear in URLs.
// The reserved slug `skills` is used by the file-uploads tab and
// can't be claimed by a regular page (enforced in the API layer).
//
// `position` is a plain integer; admin reorders by setting a new
// value (we don't bother with fractional indexes). On delete we
// don't compact other pages' positions — gaps are fine and avoid
// renumbering churn.
model DocPage {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  markdown    String   @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation("DocPageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([position], name: "idx_doc_pages_position")
  @@map("doc_pages")
}

enum Role {
  user
  admin
}

enum EntityType {
  company
  person
  brand
  team
  product
  org
  other
}

enum ShapePref {
  square
  circle
  auto
}

enum RenderStatus {
  pending
  rendering
  complete
  failed
}
